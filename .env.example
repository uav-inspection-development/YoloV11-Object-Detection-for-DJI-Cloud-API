# Docker Compose Environment Variables
# Copy this file to .env and modify the values as needed

# YOLO App Configuration
RUN_MODE=streamlit
ENTRYPOINT_SCRIPT=ui.py

# OAuth2 Configuration (if using authentication)
OAUTH2_INTROSPECT_URL=https://your-auth-server.com/oauth2/introspect
OAUTH2_TOKEN_URL=https://your-auth-server.com/oauth2/token
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret

# MediaMTX Configuration
MEDIAMTX_HOST=mediamtx
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_API_PORT=9997

# Network Configuration
YOLO_NETWORK_SUBNET=172.20.0.0/16
